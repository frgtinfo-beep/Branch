# --- Existing ---
MONGODB_URI=
MONGODB_DB=Branch
GMAIL_USER=
GMAIL_APP_PASSWORD=
PORT=3000

# --- GoCardless ---
# "sandbox" while testing, "live" once you cut over. Switches both the API
# base URL and which access token is used — see README for the cutover steps.
GOCARDLESS_ENVIRONMENT=sandbox
GOCARDLESS_ACCESS_TOKEN=
# From the webhook endpoint's settings in the GoCardless dashboard — sandbox
# and live have SEPARATE webhook endpoints and secrets, registered separately.
GOCARDLESS_WEBHOOK_SECRET=

# Public base URL of this deployment, no trailing slash. Used to build the
# GoCardless onboarding redirect/exit URLs.
APP_BASE_URL=http://localhost:3000

# IANA timezone used for "1st of the month" / "N days before" billing-date
# math, independent of the server's own timezone.
BILLING_TIMEZONE=Europe/Amsterdam

# --- Admin panel ---
# Session cookie signing secret — any long random string.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
ADMIN_USERNAME=
# Generate with: npm run hash-admin-password -- 'your-chosen-password'
ADMIN_PASSWORD_HASH=
